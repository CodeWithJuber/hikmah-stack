{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/context.sh\" session-start",
            "timeout": 10,
            "statusMessage": "Loading Hikmah Stack context"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/context.sh\" prompt",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/truth_gate.sh\"",
            "timeout": 8,
            "statusMessage": "Running Hikmah Truth Gate (deterministic)"
          }
        ]
      }
    ]
  }
}
