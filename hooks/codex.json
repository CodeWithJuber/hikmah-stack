{
  "description": "Hikmah Stack completion hygiene gate. Prefers the Rust kernel, with a zero-install compatibility fallback.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh ${PLUGIN_ROOT}/hooks/truth_gate.sh",
            "timeout": 8,
            "statusMessage": "Running Hikmah Truth Gate"
          }
        ]
      }
    ]
  }
}
