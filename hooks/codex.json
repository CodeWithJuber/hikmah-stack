{
  "description": "Hikmah Stack hooks: session context and per-prompt skill routing (plus recalled memory when the hikmah CLI is installed), and the completion hygiene gate, which runs an installed hikmah binary, then the zero-install Python fallback. Never compiles code.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks/context.sh\" session-start",
            "timeout": 10,
            "statusMessage": "Loading Hikmah Stack context"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks/context.sh\" prompt",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks/truth_gate.sh\"",
            "timeout": 8,
            "statusMessage": "Running Hikmah Truth Gate"
          }
        ]
      }
    ]
  }
}
